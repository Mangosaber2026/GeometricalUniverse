
{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",

        "rootDir": "./src",
        "outDir": "./src/dist",

        "lib": ["ESNext", "DOM", "DOM.Iterable"],
        "types": ["node"],

        "strict": true,
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,

        "verbatimModuleSyntax": true,

        "sourceMap": true,
        "noEmitOnError": true,
        "skipLibCheck": false,

        "jsx": "react-jsx"
    },

    "include": [
        "./src/**/*.ts",
        "./src/**/*.tsx"
    ],

    "exclude": [
        "./src/dist",
        "./node_modules"
    ]
}
