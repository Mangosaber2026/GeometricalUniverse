{
    "name": "gd-toolkit",
    "version": "1.0.0",
    "description": "Command-line toolkit for GeometricalDomination",
    "keywords": [
        "gd",
        "geometricaldomination",
        "toolkit"
    ],
    "license": "MIT",
    "author": "Miah M. Sabiq",
    "type": "module",

    "imports": {
        "#file-editing/*": {
            "types": "./src/file_editing_src/file_editing_decl/*.d.ts",
            "default": "./src/dist/file_editing_src/*.js"
        },
        "#ts-utilities/*": {
            "types": "./src/ts_utilities_src/ts_utilities_decl/*.d.ts",
            "default": "./src/dist/ts_utilities_src/*.js"
        },
        "#gd-verification/*": {
            "types": "./src/gd_verification_src/gd_verification_decl/*.d.ts",
            "default": "./src/dist/gd_verification_src/*.js"
        }
    },

    "scripts": {
        "test": "echo \"Error: no test specified\" && exit 1",
        "dev": "vite",
        "build": "tsc -b && vite build",
        "build:publishing": "tsc -p publishing_src/tsconfig.json",
        "run:publishing": "node ./publishing_src/publishing_dist/cli.js"
    },
    "devDependencies": {
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.2.1",
        "typescript": "^7.0.2",
        "vite": "^8.3.6"
    },
    "dependencies": {
        "react": "^19.3.1",
        "react-dom": "^19.3.1"
    }
}
